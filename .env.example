# Normalmente voce NAO precisa deste arquivo: scripts/instalar.sh (ou
# instalar.ps1) cria o .env com senhas aleatorias. Use-o como referencia ou
# para instalar a mao. O .env nunca vai para o git.

# Senhas do banco (o instalador gera valores aleatorios).
POSTGRES_PASSWORD=troque-esta-senha
FONTECA_API_SENHA=troque-esta-senha
FONTECA_INGEST_SENHA=troque-esta-senha
FONTECA_LEITURA_SENHA=troque-esta-senha

# Vazio: HTTP em http://localhost:PORTA_HTTP. Com dominio: HTTPS automatico
# (use PORTA_HTTP=80 e PORTA_HTTPS=443 numa VM).
DOMINIO=
PORTA_HTTP=8080
PORTA_HTTPS=8443

# Memoria do Postgres. Para a base completa, algo como 25% da RAM da maquina.
PG_SHARED_BUFFERS=512MB

# So para desenvolvimento a partir do codigo-fonte (docs/desenvolvimento.md):
# FONTECA_DSN=postgres://fonteca:troque-esta-senha@localhost:5433/fonteca?sslmode=disable
# FONTECA_DSN_API=postgres://fonteca_api:troque-esta-senha@localhost:5433/fonteca?sslmode=disable
